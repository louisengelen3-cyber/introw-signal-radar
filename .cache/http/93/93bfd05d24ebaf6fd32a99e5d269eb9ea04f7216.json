{"url":"https://www.rechner.com/","ok":true,"status":200,"retrievedAt":"2026-08-21T13:48:58.082Z","finalUrl":"https://www.rechner.com/","contentType":"text/html; charset=UTF-8","body":"<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Transitional//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd\">\n<html>\n<head>\n<meta name=\"keywords\" content=\"Capacitive Sensors, Level Control, Level Sensor, Capacitive Sensor, Capacitive, Rechner Sensors, Capacitive Level Sensor, Capacitive Level Sensor, Proximity Sensor, Home\">\n<meta name=\"description\" content=\"Rechner Sensors is the world leader in capacitive sensing technologies for industrial automation and level control.\">\n<meta hhtp-equiv=\"Content-Type\" content=\"text/html; charset=utf-8\" />\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=0.5\">\n<title>Rechner Sensors</title>\n<style type=\"text/css\">\n.buybutton {\n\theight: 80px;\n\twidth: 310px;\n\tmargin-left: auto;\n\tmargin-right: 0;\n\tfloat: right;\n\tclear: right;\n\tpadding-left: 6px;\n\tpadding-top: 8px;\n}\n</style>\n<link href=\"https://www.rechner.com/rechnerstyle.css\" rel=\"stylesheet\" type=\"text/css\" />\n<link rel=\"icon\" type=\"image/png\" href=\"/images/RS icon.png\">\n</head>\n\n<body>\n<div class=\"layout\">\n<div class=\"flags\">\n  <div><a href=\"https://www.rechner-sensors.com\"><img class=\"flag\" src=\"/images/flag DE.svg\" alt=\"Germany Deutsch\" title=\"Rechner Germany\" /></a></div>\n  <div><a href=\"https://www.rechner-sensors.com/en/\"><img class=\"flag\" src=\"/images/flag DEENG.svg\" alt=\"Germany English\" title=\"Rechner Germany: English\" style=\"background-color: white;\" /></a></div>\n  <div><a href=\"https://www.rechner-sensors.com/fr/\"><img class=\"flag\" src=\"/images/flag FR.svg\" alt=\"France\" title=\"Rechner France\" /></a></div>\n  <div><a href=\"https://www.rechner-sensors.com/es/\"><img class=\"flag\" src=\"/images/flag ESP.svg\" alt=\"Spain\" title=\"Rechner Spain\" /></a></d