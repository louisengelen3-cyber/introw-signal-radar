{"url":"https://www.fortra.es/","ok":true,"status":200,"retrievedAt":"2026-08-21T13:54:34.519Z","finalUrl":"https://www.fortra.es/","contentType":"text/html","body":"<!DOCTYPE html>\n<html lang=\"es-ES\">\n   <head>\n      <title>Cursos para Trabajadores | Fortra Formación</title>\n      <meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\">\n      <meta charset=\"utf-8\" />\n      <meta name=\"viewport\"       content=\"width=device-width, initial-scale=1\" />\n      <meta name=\"keywords\"       content=\"Cursos de idiomas,Cursos para trabajadores,Formacion continuada,Formacion para trabajadores,Malaga,Cursos gratis,Cursos bonificados,Tarjeta profesional,Tarjeta de la construccion,Tarjeta del metal\" />\n      <meta name=\"description\"    content=\"Formación para empresas y trabajadores. Cursos bonificados para la empresa y sin coste para el trabajador. ¡Infórmate ya! \" />\n      <meta name=\"subject\"        content=\"Cursos de formación bonificada para trabajadores\" />\n      <meta name=\"author\"         content=\"Rafael Agüera\" />\n      <meta name=\"language\"       content=\"es\" />\n      <meta name=\"robots\"         content=\"index\" />\n      <meta name=\"generator\"      content=\"Visual Studio Core\" />\n\n      <link rel=\"stylesheet\" href=\"css/normalize.css\">\n      <link href=\"https://fonts.googleapis.com/css2?family=Krub:wght@400;700&display=swap\">\n      <link rel=\"preload\" href=\"css/estilos.css\" as=\"style\">\n      <link rel=\"stylesheet\" href=\"css/estilos.css\">\n   </head>\n\n   <body>\n      <header>\n         <div>\n            <img src=\"img/Logo Fortra mini.png\" alt=\"Logo Fortra Formación\">\n         </div>\n         <div class=\"telefono\">\n            952 45 03 85\n         </div>\n      </header>\n      \n      <div class=\"menu-principal-bg\">\n         <nav class=\"contenedor menu-principal\">\n            <a href=\"index.html\">Inicio</a>\n            <a href=\"https://cursos.fortra.es\" target=\"_blank\">Catálogo cursos</a>\n            <a href=\"https://campus.fortra.es\" target=\"_blank\">Acceso al Campus</a>\n            <a href=\"#contacto\">Contacto</a>\n         </nav>\n      </div>\n\n      <section class=\"hero\">\n         <div class=\"contenido-hero\">\n            <h2>Fortra <span>Formación</span></h2>\n            <a class=\"boton\" href=\"https://campus.fortra.es\" target=\"_blank\">Acceso al Campus</a>\n         </div>\n      </section>\n      \n      <main class=\"contenedor sombra\">\n         <h3>Algunos de nuestros cursos más solicitados</h3>\n\n         <div class=\"servicios\">\n            <div class=\"servicio\">\n               <h3>Idiomas</h3>\n               <div class=\"iconos\">\n                  <a href=\"https://cursos.fortra.es\" target=\"_blank\"><img src=\"img/0idiomas.jpg\" alt=\"Curso de Idiomas\"></a>\n               </div>\n            </div>\n            <div class=\"servicio\">\n               <h3>Contabilidad</h3>\n               <div class=\"iconos\">\n                  <a href=\"https://cursos.fortra.es\" target=\"_blank\"><img src=\"img/0contabilidad.jpg\" alt=\"Curso de Contabilidad\"></a>\n               </div>\n            </div>\n            <div class=\"servicio\">\n               <h3>Ofimatica</h3>\n               <div class=\"iconos\">\n                  <a href=\"https://cursos.fortra.es\" target=\"_blank\"><img src=\"img/0ofimatica.jpg\" alt=\"Curso de Ofimatica\"></a>\n               </div>\n            </div>\n         </div>\n\n         <div class=\"servicios\">\n            <div class=\"servicio\">\n               <h3>Autocad</h3>\n               <div class=\"iconos\">\n                  <a href=\"https://cursos.fortra.es\" target=\"_blank\"><img src=\"img/0autocad.jpg\" alt=\"Curso de Autocad\"></a>\n               </div>\n            </div>\n            <div class=\"servicio\">\n               <h3>Diseño Grafico</h3>\n               <div class=\"iconos\">\n                  <a href=\"https://cursos.fortra.es\" target=\"_blank\"><img src=\"img/0diseñografico.jpeg\" alt=\"Curso de Diseño Grafico\"></a>\n               </div>\n            </div>\n            <div class=\"servicio\">\n               <h3>Diseño y desarrollo Web</h3>\n               <div class=\"iconos\">\n                  <a href=\"https://cursos.fortra.es\" target=\"_blank\"><img src=\"img/0diseñoweb.jpg\" alt=\"Curso de Diseño Web\"></a>\n               </div>\n            </div>\n         </div>\n      </main>\n\n      <section id=\"contacto\">\n         <h2>CONTACTO</h2>\n            <form class=\"formulario\" action=\"php/contacto.php\" method=\"post\" onsubmit=\"return validar(this);\" />\n               <fieldset>\n                  <legend>Contactános cumplimentando todos los campos</legend>\n                  <div class=\"campo\">\n                     <label for=\"nombre\">Nombre <span>(requerido)</span></label>\n                     <input type=\"text\" name=\"nombre\" onblur=\"revisar(this);\" />\n                  </div>\n                  <div class=\"campo\">\n                     <label for=\"telefono\">Teléfono <span>(requerido)</span></label>\n                     <input type=\"tel\" name=\"telefono\" onblur=\"revisar(this);\" />\n                  </div>\n                  <div class=\"campo\">\n                     <label for=\"email\">Email <span>(requerido)</span></label>\n                     <input type=\"email\" name=\"email\" onblur=\"revisar(this);\" />\n                  </div>\n                  <div class=\"campo\">\n                     <label for=\"mensaje\">Mensaje <span>(requerido)</span></label>\n                     <textarea name=\"mensaje\" onblur=\"revisar(this);\"></textarea>\n                  </div>\n                  <div class=\"flex alinear-derecha\">\n                     <input class=\"boton w-100\" type=\"submit\" value=\"ENVIAR\">\n                  </div>\n               </fieldset>\n            </form>\n      </section>\n\n      <footer>\n         <div class=\"linea\"></div>\n         <div class=\"logopie\">\n            <img src=\"img/Logo Fortra mini.png\" alt=\"Logo Fortra Formación\">\n         </div>\n\n         <div class=\"servicios\">\n            <div class=\"servicio\">\n               <h4>Coín</h4>\n               <p>\n                  <img src=\"img/icon16-dir.png\" alt=\"Dirección\">\n                  Avda. Reina Sofía, 51 - Bajo<BR />\n                  29100 - Coín<BR />\n                  Málaga<BR />\n                  <BR /><BR />\n                  <img src=\"img/icon16-tlf.png\" alt=\"Teléfono\">\n                  (34) 952 45 03 85<BR />\n                  <img src=\"img/icon16-mail.png\" alt=\"Email\">\n                  info@fortra.es\n               </p>\n            </div>\n\n            <div class=\"servicio\">\n               <h4>Málaga</h4>\n               <p>\n                  <img src=\"img/icon16-dir.png\" alt=\"Dirección\">\n                  Poligono Industrial Guadalhorce<BR />\n                  Ctra.Intelhorce-Azucarera, nº.60<BR />\n                  29004 - Málaga<BR />\n                  Málaga<BR />\n                  <BR />\n                  <img src=\"img/icon16-tlf.png\" alt=\"Teléfono\">\n                  (34) 952 05 68 28<BR />\n                  <img src=\"img/icon16-mail.png\" alt=\"Email\">\n                  info@fortra.es\n               </p>\n            </div>\n\n            <div class=\"servicio\">\n               <h4></h4>\n               <ul>\n                  <a href=\"index.html\">Inicio</a><BR />\n                  <BR />\n                  <a href=\"https://cursos.fortra.es\" target=\"_blank\">Catálogo cursos</a><BR />\n                  <BR />\n                  <a href=\"https://campus.fortra.es\" target=\"_blank\">Acceso al Campus</a><BR />\n                  <BR />\n                  <a href=\"#contacto\">Contacto</a><BR />\n                  <BR />\n                  <a href=\"avisolegal.html\">Aviso legal</a>\n               </ul>\n            </div>\n  