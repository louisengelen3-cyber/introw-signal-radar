{"url":"https://www.backoffice.nl/","ok":true,"status":200,"retrievedAt":"2026-08-21T13:55:11.021Z","finalUrl":"https://www.backoffice.nl/","contentType":"text/html","body":"<!DOCTYPE html>\r\n<html>\r\n<head>\r\n  <meta charset=\"utf-8\" />\r\n  <meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\" />\r\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n  <meta name=\"description\" content=\"Pay4me is het softwareplatform voor verloning in de flexbranche, ontwikkeld door Brisker Group voor Pay for People en Tentoo. Log in of registreer.\">\r\n  <link rel=\"icon\" type=\"image/x-icon\" href=\"/Images/favicon/favicon-brisker.png\" id=\"FaviconLink\" />\r\n  <link type=\"text/css\" rel=\"stylesheet\" href=\"/www/assets/fonts/Font-Awesome/4.7.0/css/font-awesome.min.css\" />\r\n  <link type=\"text/css\" rel=\"stylesheet\" href=\"/www/js/lib/bootstrap/5.2.2/css/bootstrap.min.css\" />\r\n  <title>Pay4me - Online platform voor verloning in de flexbranche</title>\r\n  <style>\r\n    html, body {\r\n      height: 100%;\r\n    }\r\n\r\n    body {\r\n      height: 100vh;\r\n      margin: 0;\r\n      display: flex;\r\n      justify-content: center;\r\n      align-items: center;\r\n      background: #f1f3f5;\r\n    }\r\n\r\n    .boxbutton {\r\n      background-color: rgba(135,11,45,1);\r\n      border-color: rgba(135,11,45,1);\r\n      \r\n    }\r\n    .boxbutton:hover {\r\n      background-color: rgba(0,0,0,1);\r\n      border-color: rgba(0,0,0,1);\r\n    }\r\n\r\n    #content {\r\n      height: 100vh !important;\r\n    }\r\n\r\n    .boxcontainer {\r\n      display: flex;\r\n      flex-wrap: wrap;\r\n      max-width: 1280px;\r\n      width: 100%;\r\n      margin-left: auto;\r\n      margin-right: auto;\r\n      justify-content: center;\r\n    }\r\n\r\n    .product-card {\r\n      display: flex;\r\n      flex-direction: column;\r\n      margin: 1em;\r\n      padding: 1em;\r\n      width: calc(100% / 3 - 2em);\r\n      border: 1px solid #ccc;\r\n      min-width: 20em;\r\n      border-radius: .25rem;\r\n    }\r\n\r\n      .product-card:hover {\r\n        transform: scale(102%);\r\n        box-shadow: 0px 2px 5px rgba(150, 150, 150, .4);\r\n        border-color: #B0B0B0;\r\n      }\r\n\r\n    .headtext {\r\n      margin-top: 1em;\r\n      margin-bottom: 1em;\r\n      text-align: center;\r\n    }\r\n\r\n    .boxtext {\r\n      margin-top: 1em;\r\n      margin-bottom: 1em;\r\n    }\r\n\r\n    .button-container {\r\n      margin-top: auto;\r\n      margin-bottom: 0;\r\n    }\r\n\r\n    .card-body h3 {\r\n      text-align: center;\r\n      text-transform: uppercase;\r\n    }\r\n\r\n    @media only screen and (max-width: 600px) {\r\n      .box {\r\n        width: 100%;\r\n      }\r\n    }\r\n  </style>\r\n</head>\r\n<body>\r\n  <div class=\"card\" style=\"width: min(1270px, 92vw); margin: auto;\">\r\n    <div class=\"card-body\">\r\n      <h3>Welkom bij de Brisker Group</h3>\r\n    </div>\r\n    <hr>\r\n    <div class=\"card-body\">\r\n      <span class=\"pull-right\" style=\"position: relative; top: -1em; left: -3em;\">\r\n\r\n      </span>\r\n      <div class=\"boxcontainer\">\r\n        <div class=\"product-card\">\r\n          <div class=\"text-center text-uppercase\">\r\n            <h2>Log In</h2>\r\n          </div>\r\n          <img id=\"ctl00_ContentPlaceHolder1_PfpImage4\" class=\"img-responsive\" src=\"../Images/background-pay4me.jpg\" style=\"border-width:0px;\">\r\n          <p class=\"boxtext\">\r\n            <span id=\"ctl00_ContentPlaceHolder1_PfpLabel4\">Ben je al geregistreerd? Log dan hieronder in om direct aan de slag te gaan met Pay4me.</span>\r\n          </p>\r\n          <p class=\"text-center button-container\">\r\n            <a id=\"ctl00_ContentPlaceHolder1_hlGoToMatchingPlatform\" class=\"btn btn-primary boxbutton\" href=\"/Default.aspx\">Ga naar Pay4me</a>\r\n          </p>\r\n        </div>\r\n        <div class=\"product-card\" id=\"registration_card\">\r\n          <div class=\"text-center text-uppercase\">\r\n            <h2>Registratie</h2>\r\n          </div>\r\n          <img id=\"ctl00_ContentPlaceHolder1_PfpImage5\" class=\"img-responsive\" src=\"../Images/Freelancer.jpg\" style=\"border-width:0px;\">\r\n          <p class=\"boxtext\">\r\n            <span id=\"ctl00_ContentPlaceHolder1_PfpLabel5\">Wil je aan de slag als werknemer, freelancer of zelfstandige? Klik op de knop hieronder.</span>\r\n          </p>\r\n          <p class=\"text-center button-container\">\r\n            <a id=\"ctl00_ContentPlaceHolder1_hlRegisterFreelancer\" class=\"btn btn-primary boxbutton\" href=\"/Registreren/Default.aspx?reg=1\" target=\"_self\">Registreer</a>\r\n          </p>\r\n        </div>\r\n      </div>\r\n    </div>\r\n    <hr>\r\n    <div class=\"card-body text-center\">\r\n\r\n      <img src=\"../Images/P4P_grijs.png\" style=\"width:100px;border-width:0px;\">\r\n\r\n      <img src=\"../Images/Tentoo_grijs.png\" style=\"width:100px;border-width:0px;\">\r\n\r\n      <img src=\"../Images/Brisker_grijs.png\" style=\"width:100px;border-width:0px;\">\r\n\r\n    </div>\r\n  </div>\r\n  <script>\r\n    document.addEventListener(\"DOMContentLoaded\", function () {\r\n      if (window.location.hostname.toLowerCase().includes(\"backoffice\")) {\r\n        var card = document.getElementById(\"registration_card\");\r\n        card.style.display = \"none\";\r\n      }\r\n    });\r\n  </script>\r\n</body>\r\n</html>\r\n","blocked":false}